{
    "name": "wojt-janowski/laravel-glitchtip",
    "description": "A typed Laravel client for the GlitchTip error-tracking API.",
    "keywords": ["laravel", "glitchtip", "sentry", "error-tracking", "api-client"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wojt Janowski",
            "email": "wojt@hunterblood.au"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WojtJanowski\\GlitchTip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WojtJanowski\\GlitchTip\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WojtJanowski\\GlitchTip\\GlitchTipServiceProvider"
            ],
            "aliases": {
                "GlitchTip": "WojtJanowski\\GlitchTip\\Facades\\GlitchTip"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint",
        "refactor": "rector process",
        "spec": "curl -fsSL https://app.glitchtip.com/api/openapi.json -o tests/Fixtures/openapi.json"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
